# Copia questo file in .env.local e inserisci i valori del TUO progetto Supabase
# (dashboard Supabase -> Project Settings -> API Keys / Connect).
# Usa SOLO la Publishable key (sb_publishable_...).
# NON inserire mai la Secret key (sb_secret_...) né la service_role key:
# ogni variabile VITE_* finisce nel codice che arriva al browser.
VITE_SUPABASE_URL=https://INSERISCI-IL-TUO-PROJECT-ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=INSERISCI-LA-TUA-PUBLISHABLE-KEY
